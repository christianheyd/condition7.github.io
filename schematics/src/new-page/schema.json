{
    "$schema": "http://json-schema.org/schema",
    "$id": "NewPage",
    "title": "New Page",
    "type": "object",
    "description": "Adds everything required to add another page with the provided name",
    "properties": {
        "name": {
            "type": "string",
            "description": "Name of the page",
            "$default": {
                "$source": "argv",
                "index": 0
            }
        }
    },
    "required": [
        "name"
    ]
}